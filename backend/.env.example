NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

DB_HOST=localhost
DB_PORT=3306
DB_NAME=luvkush_natural
DB_USER=root
DB_PASS=
DB_POOL_MIN=2
DB_POOL_MAX=10

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_EXPIRES=30d
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@luvkushnatural.com
EMAIL_FROM_NAME=Luv Kush Natural

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

FRONTEND_URL=http://localhost:4200

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Required — the webhook endpoint rejects all events until this is set,
# and payments cannot be reconciled via webhook without it.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Shiprocket Integration
SHIPROCKET_EMAIL=your-shiprocket-account@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_PINCODE=000000